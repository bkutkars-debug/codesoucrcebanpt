# Node dependencies
node_modules/
**/node_modules/

# Production build outputs
dist/
**/dist/
dist-ssr/

# Local environment and secret credentials
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.local

# Python cache & compiled bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE metadata (keep extension source intact)
.idea/
.vscode/
!coderescue-ai/vscode-extension/**
